{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/SKILL.md\"; B=\"${XDG_CACHE_HOME:-$HOME/.cache}/metal/split\"; S=\"${CLAUDE_PLUGIN_ROOT}/hooks\"; N=$(ls -t \"$S\"/*.cpp \"$S\"/*.hpp \"$S\"/*.inc 2>/dev/null | head -1); if ! { [ -x \"$B\" ] && [ -n \"$N\" ] && [ ! \"$N\" -nt \"$B\" ]; }; then sh \"${CLAUDE_PLUGIN_ROOT}/build.sh\" \"$B\" || echo \"metal: the hook failed to build (compiler output above) - BOTH RULES ARE INERT this session\"; fi",
            "timeout": 60,
            "statusMessage": "Loading metal rules..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/SKILL.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${XDG_CACHE_HOME:-$HOME/.cache}/metal/split\"; [ -x \"$B\" ] && exec \"$B\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"${XDG_CACHE_HOME:-$HOME/.cache}/metal/split\"; [ -x \"$B\" ] && exec \"$B\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
